# Postgres (Vercel: use the pooled connection string from your Postgres integration)
DATABASE_URL="postgresql://sdak:sdak@localhost:5432/sdak"
# Integration tests reset this database — its name must contain "test".
TEST_DATABASE_URL="postgresql://sdak:sdak@localhost:5432/sdak_test"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
SESSION_IDLE_MINUTES=30

# First System Admin, created by `pnpm db:bootstrap`
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="System Admin"

# Outgoing email (password resets). Unset in development: emails are logged.
RESEND_API_KEY=""
EMAIL_FROM="SDAK Church Manager <no-reply@your-domain>"

# Demo seed only
DEMO_PASSWORD="Demo-pass-2026"

# SMS sign-in codes for member self-service (Africa's Talking). Unset in
# development: codes are logged with the number masked. Required in production.
AT_USERNAME=""
AT_API_KEY=""
AT_SENDER_ID=""
# Local demos of a production build only: log codes instead of sending them.
# SMS_DEV_LOG=1

# Google sign-in (optional). Only people already known can use it: staff by their account email,
# members by the email on their record. Authorised redirect URI: <site>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
